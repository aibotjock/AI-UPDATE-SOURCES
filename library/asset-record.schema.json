{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Update reusable asset record",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "path",
    "sha256",
    "bytes",
    "origin",
    "rights_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "enum": [
        "logo",
        "icon",
        "background",
        "diagram",
        "motion",
        "sound-effect",
        "presentation-component",
        "evidence-label",
        "benchmark-chart"
      ]
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "type": "string"
    },
    "rights_status": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "is_empirical_evidence": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
